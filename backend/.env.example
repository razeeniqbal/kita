# Copy to backend/.env and fill in. Never commit the real values.
# Supabase dashboard > Connect.

# Session pooler (IPv4). Use this unless your network has public IPv6.
# On Vercel use the transaction pooler instead: same host, port 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Project URL. Login tokens are checked against its public signing keys.
SUPABASE_URL=https://<project-ref>.supabase.co

# Only for projects that still sign tokens with the legacy shared secret (HS256).
# SUPABASE_JWT_SECRET=

# Only when the frontend runs on a different origin, e.g. the Angular dev server.
# CORS_ORIGINS=["http://localhost:4200"]

# Direct connection (IPv6 only). Not used by the app.
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
